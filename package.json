{
  "name": "china-ethnic-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "probe": "node scripts/probe.mjs",
    "download": "node scripts/download.mjs",
    "capture": "node scripts/capture.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "data:fetch": "node scripts/fetch-data.mjs",
    "taiwan:fetch": "node scripts/fetch-taiwan.mjs",
    "data:check": "node scripts/check-data.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "verify": "npm run format:check && npm run data:check && npm test && npm run build && npm run test:e2e",
    "photos:fetch": "node scripts/fetch-photos.mjs",
    "capture:photos": "node scripts/capture-photos.mjs",
    "format": "prettier --write src scripts tests *.ts *.json .github .prettierrc.json",
    "format:check": "prettier --check src scripts tests *.ts *.json .github .prettierrc.json",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "echarts": "^6.1.0",
    "ol": "^10.6.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "prettier": "3.6.2",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vue-tsc": "^2.2.0"
  }
}
